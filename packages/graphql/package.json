{
  "name": "@sst-monorepo/graphql",
  "version": "1.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.ts"
    },
    "./schema.graphql": "./schema.graphql"
  },
  "files": [
    "schema.graphql",
    "operations.graphql",
    "index.ts",
    "index.d.ts",
    "generated"
  ],
  "scripts": {
    "build": "graphql-codegen --config codegen.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "graphql": "^17.1.0"
  },
  "packageManager": "pnpm@10.20.0"
}
