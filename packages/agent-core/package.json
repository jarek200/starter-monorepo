{
  "name": "@sst-monorepo/agent-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bedrock AgentCore runtime (Strands) — use AWS starter toolkit CLI from this package",
  "main": "dist/agent.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/agent.js",
    "dev": "tsx watch src/agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@strands-agents/sdk": "^0.1.5",
    "bedrock-agentcore": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.20.0"
}
