# Copy to .env.local (gitignored) for local dev — never commit secrets.

AWS_REGION=eu-west-1

# AgentCore Memory — create with: agentcore add memory (then agentcore deploy)
# Short-term only: set memory id, leave LTM false
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_BATCH_SIZE=1
# Set true when memory has LTM strategies (semantic, summarization, user preference)
AGENTCORE_MEMORY_LTM=false

# Strands MCP (stdio). AWS documentation server example:
# MCP_SERVER_COMMAND=uvx
# MCP_SERVER_ARGS=awslabs.aws-documentation-mcp-server@latest

# Optional override
# AGENT_SYSTEM_PROMPT=You are a helpful assistant.
