{
  "name": "sst-monorepo-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "pnpm -r exec -- rm -rf node_modules 2>/dev/null || true && rm -rf node_modules && rm -f pnpm-lock.yaml",
    "build": "pnpm --filter web build",
    "dev": "pnpm sst dev",
    "dev:local": "pnpm --filter web dev",
    "deploy:dev": "pnpm sst deploy --stage dev",
    "deploy:stage": "pnpm sst deploy --stage stage",
    "deploy:prod": "pnpm sst deploy --stage prod",
    "remove:dev": "pnpm sst remove --stage dev",
    "remove:stage": "pnpm sst remove --stage stage",
    "sso": "aws sso login --sso-session=acme",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check . --write",
    "typecheck": "pnpm --filter './packages/*' exec -- tsc --noEmit && pnpm --filter web check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "pnpm --filter @sst-monorepo/graphql codegen",
    "codegen:watch": "pnpm --filter @sst-monorepo/graphql codegen:watch",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SST Monorepo Starter Template with Landing Page, Login, and Dashboard",
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "sst": "^4.5.7",
    "@pulumi/aws": "^7.12.0",
    "@pulumi/pulumi": "^3.209.0",
    "@types/node": "^24.10.1",
    "vitest": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "packageManager": "pnpm@10.20.0"
}
