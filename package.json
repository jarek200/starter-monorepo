{
  "name": "sst-monorepo-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "pnpm -r exec -- rm -rf node_modules .turbo 2>/dev/null || true && rm -rf node_modules .turbo && rm -f pnpm-lock.yaml",
    "build": "turbo run build",
    "dev": "pnpm sst dev --mode basic",
    "dev:tui": "pnpm sst dev",
    "dev:local": "turbo run dev --filter=@sst-monorepo/web",
    "dev:admin": "pnpm --filter @sst-monorepo/admin dev",
    "deploy:dev": "pnpm sst deploy --stage dev",
    "deploy:stage": "pnpm sst deploy --stage stage",
    "deploy:prod": "pnpm sst deploy --stage prod",
    "remove:dev": "pnpm sst remove --stage dev",
    "remove:stage": "pnpm sst remove --stage stage",
    "sso": "aws sso login --sso-session=acme",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check . --write",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:turbo": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "turbo run codegen",
    "codegen:watch": "pnpm --filter @sst-monorepo/graphql codegen:watch",
    "prepare": "husky",
    "verify": "pnpm codegen && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "sst",
    "svelte",
    "sveltekit",
    "aws",
    "appsync",
    "graphql",
    "dynamodb",
    "cognito",
    "turborepo",
    "monorepo",
    "starter",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "SST Monorepo Starter Template with Landing Page, Login, and Dashboard",
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@pulumi/aws": "^7.12.0",
    "@pulumi/pulumi": "^3.209.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.14",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "sst": "^4.5.7",
    "turbo": "^2.8.20",
    "vitest": "^4.0.14"
  },
  "packageManager": "pnpm@10.20.0"
}
