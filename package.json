{
  "name": "sst-monorepo-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm sst dev --mode basic",
    "build": "turbo run build",
    "lint": "pnpm exec biome check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "codegen": "turbo run codegen",
    "verify": "pnpm codegen && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sst:deploy": "pnpm exec sst deploy --stage",
    "sst:remove": "pnpm exec sst remove --stage",
    "sso": "aws sso login --sso-session=acme",
    "prepare": "husky"
  },
  "keywords": [
    "sst",
    "svelte",
    "sveltekit",
    "aws",
    "appsync",
    "graphql",
    "dynamodb",
    "cognito",
    "turborepo",
    "monorepo",
    "starter",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "description": "SST monorepo starter — SvelteKit web app (landing, login, dashboard), AppSync, Cognito",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@pulumi/aws": "^7.44.0",
    "@pulumi/pulumi": "^3.261.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "sst": "^4.17.1",
    "turbo": "^2.10.12",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.20.0"
}
